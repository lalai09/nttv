    function updateMiniWord() {
        const miniWordEl = document.getElementById('wd-mini-word');
        if (!miniWordEl) return;

        if (!currentBestMove || !currentBestMove.word) {
            miniWordEl.textContent = '✗ Hết nước';
            miniWordEl.style.color = '#f87171';
            return;
        }

        const second = currentBestMove.word.split(' ')[1];
        const colorMap = {
            dead: '#ff5c7a',
            trap: '#ff8c00',
            ok: '#4ade80',
            'risk-trap': '#ffd700',
            'risk-dead': '#c9a9ff'
        };
        const prefixMap = {
            dead: '✓ ',
            trap: '★ ',
            ok: '',
            'risk-trap': '⚠ ',
            'risk-dead': '⚠ '
        };
        miniWordEl.textContent = (prefixMap[currentBestMove.kind] || '') + second;
        miniWordEl.style.color = colorMap[currentBestMove.kind] || '#4ade80';
    }

    function attachToggle(panel, miniPanel) {
        const toggleBtn = panel.querySelector('#wd-toggle');
        const bodyEl = panel.querySelector('#wd-body');
        let collapsed = loadCollapsed();
        function apply() {
            bodyEl.style.display = collapsed ? 'none' : 'block';
            toggleBtn.textContent = collapsed ? '+' : '−';
            saveCollapsed(collapsed);
        }
        apply();

        let pressTimer = null;
        let longPressed = false;

        toggleBtn.addEventListener('click', e => {
            e.stopPropagation();
            if (longPressed) { longPressed = false; return; }
            collapsed = !collapsed;
            apply();
        });
        toggleBtn.addEventListener('touchstart', e => {
            e.stopPropagation();
            longPressed = false;
            pressTimer = setTimeout(() => {
                longPressed = true;
                setUltraMini(true, panel, miniPanel);
            }, 480);
        }, { passive: true });
        toggleBtn.addEventListener('touchend', () => clearTimeout(pressTimer));
        toggleBtn.addEventListener('touchmove', () => clearTimeout(pressTimer));
        toggleBtn.addEventListener('mousedown', () => {
            longPressed = false;
            pressTimer = setTimeout(() => {
                longPressed = true;
                setUltraMini(true, panel, miniPanel);
            }, 480);
        });
        toggleBtn.addEventListener('mouseup', () => clearTimeout(pressTimer));

        if (ultraMini) setUltraMini(true, panel, miniPanel);
    }

    function attachMiniPanel(miniPanel, panel) {
        let pressTimer = null;
        let longPressed = false;

        function restore() {
            setUltraMini(false, panel, miniPanel);
        }

        miniPanel.addEventListener('touchstart', () => {
            longPressed = false;
            pressTimer = setTimeout(() => {
                longPressed = true;
                restore();
            }, 380);
        }, { passive: true });
        miniPanel.addEventListener('touchend', () => clearTimeout(pressTimer));
        miniPanel.addEventListener('touchmove', () => clearTimeout(pressTimer));

        miniPanel.addEventListener('mousedown', () => {
            longPressed = false;
            pressTimer = setTimeout(() => {
                longPressed = true;
                restore();
            }, 380);
        });
        miniPanel.addEventListener('mouseup', () => clearTimeout(pressTimer));

        // Chạm nhanh (không giữ) vào mini panel = gửi luôn từ điểm cao nhất
        miniPanel.addEventListener('click', () => {
            if (longPressed) { longPressed = false; return; }
            const bestEl = document.getElementById('wd-ai-best');
            if (bestEl && bestEl.onclick) bestEl.onclick();
        });
    }

    function attachBgToggle(panel) {
