    function fillAndSubmit(full) {
        lastSubmitted = full;
        usedWords.add(full);
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(full).catch(() => {});
        }
        const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
        if (!input) return;
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
        if (setter) setter.call(input, full);
        else input.value = full;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();

        setTimeout(() => {
            let sendBtn =
                document.querySelector('button[class*="submitBtn"], button[class*="submit"]') ||
                Array.from(document.querySelectorAll('button')).find(b =>
                    b.querySelector('svg') ||
                    /gửi|submit|ok|xác nhận|gửi từ/i.test((b.textContent || '').trim())
                );
            if (sendBtn) {
                sendBtn.click();
            } else {
                ['keydown', 'keypress', 'keyup'].forEach(type => {
                    input.dispatchEvent(new KeyboardEvent(type, {
                        key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true
                    }));
                });
            }
        }, 60);
    }

    function tryAutoPlay() {
        if (!autoEnabled) return;
        clearTimeout(autoTimer);
        if (!currentBestMove || !currentBestMove.word) return;
        const full = currentBestMove.word;
        const delay = 250 + Math.random() * 250;
        autoTimer = setTimeout(() => {
            if (!autoEnabled) return;
            fillAndSubmit(full);
        }, delay);
    }

    function attachClearButton(panel) {
        const btn = panel.querySelector('#wd-clear');
        btn.addEventListener('click', e => {
            e.stopPropagation();
            usedWords.clear();
            badWords.clear();
            saveBadWords(badWords);
            lastSkippedWord = null;
            clearTimeout(autoTimer);
            clearTimeout(skipTimer);
            const statusEl = document.getElementById('wd-status');
            if (statusEl) {
                statusEl.textContent = 'Đã xóa';
                statusEl.style.color = '#fbbf24';
                setTimeout(updateDictStatus, 1200);
            }
            if (lastText) renderSuggestions(lastText);
        });
    }

    function chip(full, kind, scoreLabel) {
        const second = full.split(' ')[1];
        const styles = {
            trap: { bg: 'rgba(255,140,0,.20)', border: '#ff8c00', color: '#ffcc80', mark: '★ ' },
            dead: { bg: 'rgba(255,92,122,.16)', border: '#ff5c7a', color: '#ffb3c1', mark: '✓ ' },
            'risk-trap': { bg: 'rgba(255,215,0,.18)', border: '#ffd700', color: '#fff3b0', mark: '✗ ' },
            'risk-dead': { bg: 'rgba(147,112,219,.18)', border: '#9370db', color: '#d4c1ff', mark: '✗ ' },
            ok:   { bg: 'rgba(0,255,204,.10)', border: '#00ffcc', color: '#e6fffb', mark: '' }
        };
        const s = styles[kind] || styles.ok;
        const badge = (scoreLabel !== undefined && scoreLabel !== null)
            ? `<span class="wd-score-badge">${scoreLabel}</span>` : '';
        return `<div class="wd-sugg" data-full="${full}" data-kind="${kind}"
            style="background:${s.bg};border-color:${s.border};color:${s.color};">
            ${s.mark}${second}${badge}
        </div>`;
    }

    // ===== AI ưu tiên tuyệt đối Cụt (bản nhanh, dùng khi tắt Deep mode) =====
    function pickBestMove(traps, deads, oks, riskTraps, riskDeads) {
        if (deads.length) {
            return {
                word: deads[0],
                kind: 'dead',
                reason: '✓ Cụt đường — ép đối thủ hết nước nối (ưu tiên cao nhất)'
            };
        }
        if (traps.length) {
            return {
                word: traps[0],
                kind: 'trap',
                reason: '★ Bẫy — đối thủ dễ bị kẹt'
            };
        }
        if (oks.length) {
            return {
                word: oks[0],
                kind: 'ok',
                reason: 'Thường — nước đi an toàn, giữ thế'
            };
        }
        if (riskTraps.length) {
            return {
                word: riskTraps[0],
                kind: 'risk-trap',
                reason: '⚠ Risk Bẫy — chỉ dùng khi hết lựa chọn tốt'
            };
        }
        if (riskDeads.length) {
            return {
                word: riskDeads[0],
                kind: 'risk-dead',
                reason: '⚠ Risk Cụt — nguy hiểm, tránh nếu được'
            };
        }
        return null;
    }

    // ===== AI SIÊU PHÂN TÍCH CHIẾN THUẬT (Minimax độ sâu N + đánh giá điểm) =====

    // Tính điểm "sức khỏe" của một từ: mô phỏng các lượt tiếp theo giữa 2 bên
    function evaluateWordStrength(word, badWordsSet, usedSet, depth, isMyTurn) {
        if (depth <= 0) return 0;

        const ns = word.split(' ')[1];
        const opts = (byFirst.get(ns) || []).filter(w =>
            w !== word && !badWordsSet.has(w) && !usedSet.has(w)
        );

        // Không còn nước đi -> cực tốt nếu là lượt đối thủ (họ bí), cực xấu nếu là lượt mình (mình bí)
        if (opts.length === 0) {
            return isMyTurn ? -1000 : 1000;
        }

        let bestScore = isMyTurn ? -Infinity : Infinity;

        // Giới hạn số nhánh xét để tránh lag (top 6 theo heuristic nhanh)
        const candidates = opts
            .map(w => ({
                w,
                trap: trapSet.has(w) ? 1 : 0,
                deadImmediate: isDeadEndWord(w, badWordsSet) ? 1 : 0
            }))
            .sort((a, b) => (b.deadImmediate - a.deadImmediate) || (b.trap - a.trap))
            .slice(0, 6);

        for (const cand of candidates) {
            const newUsed = new Set(usedSet);
            newUsed.add(cand.w);

            let score = 0;
            if (cand.deadImmediate) {
                score = isMyTurn ? 900 : -900;
            } else if (cand.trap) {
                score = isMyTurn ? 300 : -300;
            }

            score += evaluateWordStrength(cand.w, badWordsSet, newUsed, depth - 1, !isMyTurn);

            if (isMyTurn) {
                bestScore = Math.max(bestScore, score);
            } else {
                bestScore = Math.min(bestScore, score);
            }
        }

        return bestScore;
    }

    // Chấm điểm tổng thể cho một nước đi ứng viên của MÌNH
    function scoreMove(word, badWordsSet, usedSet, depth) {
        const newUsed = new Set(usedSet);
        newUsed.add(word);

        // Sau khi mình đi "word", đối thủ đi tiếp -> isMyTurn=false
        const depthScore = evaluateWordStrength(word, badWordsSet, newUsed, depth, false);

        let baseScore = 0;
        if (isDeadEndWord(word, badWordsSet)) baseScore += 500;
        if (trapSet.has(word)) baseScore += 150;

        const ns = word.split(' ')[1];
        const nextOpts = (byFirst.get(ns) || []).filter(w => w !== word && !badWordsSet.has(w) && !newUsed.has(w));
        const scarcityBonus = nextOpts.length === 0 ? 400 : Math.max(0, 20 - nextOpts.length) * 5;

        return baseScore + scarcityBonus + depthScore;
    }

    // Chọn nước đi tốt nhất bằng phân tích sâu, kèm top 3 lựa chọn thay thế
    function pickBestMoveDeep(traps, deads, oks, riskTraps, riskDeads, badWordsSet, depth) {
        const allCandidates = [...deads, ...traps, ...oks, ...riskTraps, ...riskDeads];
        if (!allCandidates.length) return null;

        // Giới hạn số ứng viên phân tích sâu (top 10 theo heuristic nhanh) để tránh treo máy
        const quickSorted = allCandidates
            .map(w => ({
                w,
                quick: (isDeadEndWord(w, badWordsSet) ? 1000 : 0) + (trapSet.has(w) ? 200 : 0)
            }))
            .sort((a, b) => b.quick - a.quick)
            .slice(0, 10);

        const scored = quickSorted.map(cand => ({
            w: cand.w,
            score: scoreMove(cand.w, badWordsSet, usedWords, depth),
            immediateDead: isDeadEndWord(cand.w, badWordsSet)
        }));

        // Cụt ngay lập tức luôn thắng tuyệt đối, không so điểm depth với các phương án khác
        const immediateDeads = scored.filter(s => s.immediateDead).sort((a, b) => b.score - a.score);
        const rest = scored.filter(s => !s.immediateDead).sort((a, b) => b.score - a.score);
        const ranked = immediateDeads.length ? [...immediateDeads, ...rest] : rest;

        if (!ranked.length) return null;

        const best = ranked[0].w;
        const bestScore = ranked[0].score;
        const alternatives = ranked.slice(1, 4); // top 3 lựa chọn thay thế

        let kind = 'ok';
        if (deads.includes(best)) kind = 'dead';
        else if (traps.includes(best)) kind = 'trap';
        else if (riskTraps.includes(best)) kind = 'risk-trap';
        else if (riskDeads.includes(best)) kind = 'risk-dead';

        const reasonMap = {
            dead: `✓ Cụt đường ngay — điểm chiến thuật: ${bestScore.toFixed(0)}`,
            trap: `★ Bẫy tốt — phân tích ${depth} lượt tiếp theo, điểm: ${bestScore.toFixed(0)}`,
            ok: `Nước an toàn — dẫn đối thủ vào thế bí sau vài lượt (điểm: ${bestScore.toFixed(0)})`,
            'risk-trap': `⚠ Có rủi ro nhưng vẫn tối ưu nhất hiện có (điểm: ${bestScore.toFixed(0)})`,
            'risk-dead': `⚠ Nguy hiểm — cân nhắc kỹ (điểm: ${bestScore.toFixed(0)})`
        };

        return {
            word: best,
            kind,
            reason: reasonMap[kind],
            score: bestScore,
            alternatives // [{w, score}, ...]
        };
    }

    function kindOfWord(word, traps, deads, riskTraps, riskDeads) {
        if (deads.includes(word)) return 'dead';
        if (traps.includes(word)) return 'trap';
        if (riskTraps.includes(word)) return 'risk-trap';
        if (riskDeads.includes(word)) return 'risk-dead';
        return 'ok';
    }

    let currentBestMove = null;

    function updateAISuggestion(best) {
        currentBestMove = best;
        const bestEl = document.getElementById('wd-ai-best');
        const reasonEl = document.getElementById('wd-ai-reason');
        const altEl = document.getElementById('wd-ai-alt');
        if (!bestEl || !reasonEl || !altEl) return;

        if (!best) {
            bestEl.textContent = 'Không còn nước đi';
            bestEl.style.color = '#f87171';
            reasonEl.textContent = '';
            altEl.innerHTML = '';
            bestEl.onclick = null;
            return;
        }

        const second = best.word.split(' ')[1];
        const colorMap = {
            dead: '#ff5c7a',
            trap: '#ff8c00',
            ok: '#4ade80',
            'risk-trap': '#ffd700',
            'risk-dead': '#c9a9ff'
        };
        bestEl.textContent = second;
        bestEl.style.color = colorMap[best.kind] || '#4ade80';
        reasonEl.textContent = best.reason;

        bestEl.onclick = () => {
            fillAndSubmit(best.word);
            bestEl.style.background = 'linear-gradient(135deg,#10b981,#059669)';
            bestEl.style.color = '#fff';
            bestEl.style.borderRadius = '8px';
            bestEl.style.padding = '2px 10px';
        };

        updateMiniWord();

        // Hiển thị top lựa chọn thay thế (nếu có, từ chế độ Deep)
        if (best.alternatives && best.alternatives.length) {
            altEl.innerHTML = `<span style="opacity:.6;">Khác:</span>` + best.alternatives.map(a => {
                const w2 = a.w.split(' ')[1];
                return `<span class="wd-ai-alt-item" data-full="${a.w}">${w2} (${a.score.toFixed(0)})</span>`;
            }).join('');
            altEl.querySelectorAll('.wd-ai-alt-item').forEach(el => {
                el.onclick = () => fillAndSubmit(el.dataset.full);
            });
        } else {
            altEl.innerHTML = '';
        }
    }

    function renderSuggestions(text) {
        const box = document.getElementById('wd-suggest');
        if (!box) return;

        const preview = document.getElementById('wd-preview');
        if (preview) preview.style.display = 'none';

        if (!dictReady) {
            box.innerHTML = `<div class="wd-empty-msg" style="color:#fbbf24;">Đang tải kho từ...</div>`;
            updateAISuggestion(null);
            updateMiniWord();
            return;
        }

        const norm = normWord(text);
        const parts = norm.split(' ');
        if (parts.length !== 2) {
            box.innerHTML = `<div class="wd-empty-msg">Từ không hợp lệ (2 âm tiết)</div>`;
            updateAISuggestion(null);
            updateMiniWord();
            return;
        }

        const key = parts[1];
        const available = (byFirst.get(key) || []).filter(w => w !== norm && !badWords.has(w) && !usedWords.has(w));

        if (!available.length) {
            box.innerHTML = `<div class="wd-empty-msg" style="color:#f87171;">Hết từ nối cho "${key}"</div>`;
            updateAISuggestion(null);
            updateMiniWord();
            if (lastTrapAlertKey !== norm) {
                lastTrapAlertKey = norm;
            }
            if (autoEnabled && lastSkippedWord !== norm) {
                lastSkippedWord = norm;
                clearTimeout(skipTimer);
                skipTimer = setTimeout(() => {
                    if (autoEnabled && lastText && normWord(lastText) === norm) {
                        sendSkip();
                    }
                }, 300 + Math.random() * 300);
            }
            return;
        }

        const traps = [], deads = [], riskTraps = [], riskDeads = [], oks = [];
        available.forEach(w => {
            if (trapSet.has(w)) traps.push(w);
            else if (isDeadEndWord(w, badWords)) deads.push(w);
            else {
                const risk = isRiskyTrap(w, badWords);
                if (risk === 'risk-trap') riskTraps.push(w);
                else if (risk === 'risk-dead') riskDeads.push(w);
                else oks.push(w);
            }
        });

        const best = deepModeOn
            ? pickBestMoveDeep(traps, deads, oks, riskTraps, riskDeads, badWords, deepDepth)
            : pickBestMove(traps, deads, oks, riskTraps, riskDeads);
        updateAISuggestion(best);

        // Thứ tự hiển thị: Cụt → Bẫy → Thường → Risk
        const lim = 14;
        if (deepModeOn) {
            // Gắn điểm chiến thuật nhanh (heuristic, không đệ quy sâu) lên từng chip để tham khảo
            const withScore = (w, kind) => {
                const isBest = best && best.word === w;
                const altHit = best && best.alternatives && best.alternatives.find(a => a.w === w);
                const scoreLabel = isBest
                    ? Math.round(best.score)
                    : (altHit ? Math.round(altHit.score) : null);
                return chip(w, kind, scoreLabel);
            };
            box.innerHTML =
                deads.slice(0, lim).map(w => withScore(w, 'dead')).join('') +
                traps.slice(0, lim).map(w => withScore(w, 'trap')).join('') +
                oks.slice(0, lim).map(w => withScore(w, 'ok')).join('') +
                riskTraps.slice(0, lim).map(w => withScore(w, 'risk-trap')).join('') +
                riskDeads.slice(0, lim).map(w => withScore(w, 'risk-dead')).join('');
        } else {
            box.innerHTML =
                deads.slice(0, lim).map(w => chip(w, 'dead')).join('') +
                traps.slice(0, lim).map(w => chip(w, 'trap')).join('') +
                oks.slice(0, lim).map(w => chip(w, 'ok')).join('') +
                riskTraps.slice(0, lim).map(w => chip(w, 'risk-trap')).join('') +
                riskDeads.slice(0, lim).map(w => chip(w, 'risk-dead')).join('');
        }

        if (traps.length && lastTrapAlertKey !== norm) {
            lastTrapAlertKey = norm;
        }

        box.querySelectorAll('.wd-sugg').forEach(el => {
            let pressTimer = null;
            let longPressed = false;

            function showPreview() {
                longPressed = true;
                const full = el.dataset.full;
                const nextKey = full.split(' ')[1];
                const nextList = (byFirst.get(nextKey) || []).filter(w => !badWords.has(w) && !usedWords.has(w));

                let preview = document.getElementById('wd-preview');
                if (!preview) {
                    preview = document.createElement('div');
                    preview.id = 'wd-preview';
                    document.body.appendChild(preview);
                }

                if (!nextList.length) {
                    preview.innerHTML = `<div style="color:#f87171;">Hết từ nối sau "<b>${nextKey}</b>"</div>`;
                } else {
                    const nTraps = [], nDeads = [], nRiskTraps = [], nRiskDeads = [], nOks = [];
                    nextList.forEach(w => {
                        if (trapSet.has(w)) nTraps.push(w);
                        else if (isDeadEndWord(w, badWords)) nDeads.push(w);
                        else {
                            const risk = isRiskyTrap(w, badWords);
                            if (risk === 'risk-dead') nRiskDeads.push(w);
                            else if (risk === 'risk-trap') nRiskTraps.push(w);
                            else nOks.push(w);
                        }
                    });
                    let html = `<div style="font-weight:800;color:#00ffcc;margin-bottom:5px;">Sau "${nextKey}" (${nextList.length})</div>`;
                    if (nDeads.length) html += `<div style="color:#ff5c7a;margin-top:3px;font-weight:700;">✓ Cụt</div>` + nDeads.slice(0, 6).map(w => `<div>• ${w.split(' ')[1]}</div>`).join('');
                    if (nTraps.length) html += `<div style="color:#ff8c00;margin-top:3px;font-weight:700;">★ Bẫy</div>` + nTraps.slice(0, 8).map(w => `<div>• ${w.split(' ')[1]}</div>`).join('');
                    if (nOks.length) html += `<div style="color:#7bf5e0;margin-top:3px;font-weight:700;">Thường</div>` + nOks.slice(0, 10).map(w => `<div>• ${w.split(' ')[1]}</div>`).join('');
                    if (nRiskTraps.length) html += `<div style="color:#ffd700;margin-top:3px;font-weight:700;">✗ Tránh (bẫy)</div>` + nRiskTraps.slice(0, 6).map(w => `<div>• ${w.split(' ')[1]}</div>`).join('');
                    if (nRiskDeads.length) html += `<div style="color:#c9a9ff;margin-top:3px;font-weight:700;">✗ Tránh (cụt)</div>` + nRiskDeads.slice(0, 6).map(w => `<div>• ${w.split(' ')[1]}</div>`).join('');
                    preview.innerHTML = html;
                }

                const rect = el.getBoundingClientRect();
                preview.style.display = 'block';
                preview.style.left = Math.min(rect.left, window.innerWidth - 260) + 'px';
                preview.style.top = (rect.bottom + 6) + 'px';
            }

            function hidePreview() {
                const preview = document.getElementById('wd-preview');
                if (preview) preview.style.display = 'none';
            }

            el.addEventListener('mouseenter', showPreview);
            el.addEventListener('mouseleave', hidePreview);

            el.addEventListener('touchstart', () => {
                longPressed = false;
                pressTimer = setTimeout(showPreview, 380);
            }, { passive: true });
            el.addEventListener('touchend', () => {
                clearTimeout(pressTimer);
                if (longPressed) {
                    hidePreview();
                    return;
                }
            });
            el.addEventListener('touchmove', () => {
                clearTimeout(pressTimer);
            });

            el.onclick = () => {
                if (longPressed) { longPressed = false; return; }
                const full = el.dataset.full;
                fillAndSubmit(full);
                el.style.background = 'linear-gradient(135deg,#10b981,#059669)';
                el.style.color = '#fff';
                hidePreview();
            };
        });

        if (autoEnabled) tryAutoPlay();
    }

    let lastText = "";

    function scanWord() {
        initUI();

        const allTextElements = document.querySelectorAll('*');
        let matchedText = "";

        for (let el of allTextElements) {
            if (el.closest('#wd-mobile-panel')) continue;
            if (el.children.length === 0 && el.innerText) {
                const text = el.innerText.trim();

                if (
                    text.length >= 2 &&
                    !text.includes('\n') &&
                    !['ĐIỂM', 'Đối thủ', 'Bỏ qua', 'ĐÃ NỐI', 'esc', 'Bot', 'Chơi', 'nhóm'].some(k => text.includes(k)) &&
                    !/^\d+$/.test(text)
                ) {
                    const style = window.getComputedStyle(el);
                    if (parseFloat(style.fontSize) >= 20 && el.getBoundingClientRect().height > 0) {
                        matchedText = text;
                    }
                }
            }
        }

        if (matchedText && matchedText !== lastText) {
            lastText = matchedText;

            const norm = normWord(matchedText);
            if (norm && norm.split(' ').length === 2) {
                usedWords.add(norm);
            }

            const origEl = document.getElementById('wd-original');
            if (origEl) {
                origEl.innerText = matchedText;
            }

            renderSuggestions(matchedText);
        }
    }

    setTimeout(initUI, 1000);
    loadWords();
    setInterval(loadWords, 15000);
    setInterval(scanWord, 200);

    // ===== Chống bị đẩy lên khi bàn phím ảo mở =====
    function repositionForKeyboard() {
        if (!window.visualViewport) return;
        const panel = document.getElementById('wd-mobile-panel');
        const miniPanel = document.getElementById('wd-mini-panel');

        const vv = window.visualViewport;
        const offsetTop = vv.offsetTop || 0;

        if (panel) {
            panel.style.setProperty('top', (offsetTop + 8) + 'px', 'important');
        }
        if (miniPanel) {
            miniPanel.style.setProperty('top', (offsetTop + 8) + 'px', 'important');
        }
    }

    if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', repositionForKeyboard);
        window.visualViewport.addEventListener('scroll', repositionForKeyboard);
    }
    window.addEventListener('scroll', repositionForKeyboard, { passive: true });
    setInterval(repositionForKeyboard, 300);
})();
