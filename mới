    function attachDrag(panel, header) {
        const saved = loadPos();
        if (saved && saved.left && saved.top) {
            panel.style.setProperty('left', saved.left, 'important');
            panel.style.setProperty('top', saved.top, 'important');
            panel.style.setProperty('right', 'auto', 'important');
        }

        let dragging = false, ox = 0, oy = 0;
        function start(x, y, target) {
            if (target.closest('#wd-toggle') || target.closest('.wd-btn')) return false;
            const rect = panel.getBoundingClientRect();
            ox = x - rect.left;
            oy = y - rect.top;
            panel.style.setProperty('left', rect.left + 'px', 'important');
            panel.style.setProperty('top', rect.top + 'px', 'important');
            panel.style.setProperty('right', 'auto', 'important');
            return true;
        }
        function move(x, y) {
            const w = panel.offsetWidth, h = panel.offsetHeight;
            let left = Math.max(4, Math.min(window.innerWidth - w - 4, x - ox));
            let top = Math.max(4, Math.min(window.innerHeight - h - 4, y - oy));
            panel.style.setProperty('left', left + 'px', 'important');
            panel.style.setProperty('top', top + 'px', 'important');
            savePos(panel.style.left, panel.style.top);
        }
        header.addEventListener('mousedown', e => { dragging = start(e.clientX, e.clientY, e.target); });
        document.addEventListener('mousemove', e => { if (dragging) move(e.clientX, e.clientY); });
        document.addEventListener('mouseup', () => dragging = false);
        header.addEventListener('touchstart', e => {
            dragging = start(e.touches[0].clientX, e.touches[0].clientY, e.target);
        }, { passive: true });
        panel.addEventListener('touchmove', e => {
            if (!dragging) return;
            move(e.touches[0].clientX, e.touches[0].clientY);
            e.preventDefault();
        }, { passive: false });
        panel.addEventListener('touchend', () => dragging = false);
    }

    let autoEnabled = (function () {
        try { return localStorage.getItem('wd_auto') === '1'; } catch (e) { return false; }
    })();
    function saveAuto(on) {
        try { localStorage.setItem('wd_auto', on ? '1' : '0'); } catch (e) {}
    }

    let lastSubmitted = null;
    let autoTimer = null;
    const usedWords = new Set();
    let lastSkippedWord = null;
    let skipTimer = null;
    let lastTrapAlertKey = null;

    // Bắt trường hợp người dùng tự gõ tay và gửi (không qua fillAndSubmit)
    function watchManualSubmit() {
        document.addEventListener('keydown', e => {
            if (e.key !== 'Enter') return;
            const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
            if (!input || e.target !== input) return;
            const norm = normWord(input.value);
            if (norm && norm.split(' ').length === 2) {
                usedWords.add(norm);
            }
        }, true);

        document.addEventListener('click', e => {
            const btn = e.target.closest('button');
            if (!btn) return;
            const isSubmitBtn =
                btn.matches('button[class*="submitBtn"], button[class*="submit"]') ||
                btn.querySelector('svg') ||
                /gửi|submit|ok|xác nhận|gửi từ/i.test((btn.textContent || '').trim());
            if (!isSubmitBtn) return;
            const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
            if (!input) return;
            const norm = normWord(input.value);
            if (norm && norm.split(' ').length === 2) {
                usedWords.add(norm);
            }
        }, true);
    }
    watchManualSubmit();

    // Tự động xóa phiên (usedWords) mỗi 45 giây để tránh tồn đọng sai
    setInterval(() => {
        usedWords.clear();
        if (lastText) renderSuggestions(lastText);
    }, 45000);

    function sendSkip() {
        const skipBtn = Array.from(document.querySelectorAll('button')).find(b =>
