    function setUltraMini(on, panel, miniPanel) {
        ultraMini = on;
        saveUltraMini(on);
        if (!panel) panel = document.getElementById('wd-mobile-panel');
        if (!miniPanel) miniPanel = document.getElementById('wd-mini-panel');
        if (!panel || !miniPanel) return;
        panel.style.display = on ? 'none' : 'block';
