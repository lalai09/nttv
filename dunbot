    }

    function markAsBad(word) {
      if (!word) return;
      const norm = normWord(word);
      if (!norm || norm.split(' ').length !== 2) return;
      if (badWords.has(norm)) return;
      badWords.add(norm);
      saveBadWords(badWords);
      renderBadList();
      statusEl.textContent = `Đã lưu từ lỗi: ${norm}`;
      statusEl.style.color = '#dc2626';
      setTimeout(() => {
        if (isReady) {
          statusEl.textContent = 'Sẵn sàng';
          statusEl.style.color = '#10b981';
        }
      }, 2000);
    }

    function markAsNewFromOpponent(word) {
      if (!word) return;
      const norm = normWord(word);
      if (!norm || norm.split(' ').length !== 2) return;
      const first = norm.split(' ')[0];
      const known = (byFirst.get(first) || []).includes(norm);
      if (known) return;
      if (newWords.has(norm)) return;
      newWords.add(norm);
      saveNewWords(newWords);
      renderNewList();
    }

    function sendEscape() {
      const skipBtn = Array.from(document.querySelectorAll('button')).find(b =>
        /bỏ qua|skip|pass/i.test((b.textContent || '').trim())
      );
      if (skipBtn) {
        skipBtn.click();
      } else {
        const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
        const targets = [input, document].filter(Boolean);
        targets.forEach(target => {
          target.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
          target.dispatchEvent(new KeyboardEvent('keyup', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
        });
      }
      statusEl.textContent = 'Đã tự bỏ qua';
      statusEl.style.color = '#dc2626';
      setTimeout(() => {
        if (isReady) {
          statusEl.textContent = 'Sẵn sàng';
          statusEl.style.color = '#10b981';
        }
      }, 2000);
    }

    function scheduleEscape() {
      if (!autoEnabled) return;
      if (Date.now() - lastEscTime < ESC_COOLDOWN) return;
      if (lastEscWord === lastWord) return;
      if (actionInFlight) return;
      clearTimeout(escTimer);
      actionInFlight = true;
      lastEscWord = lastWord;
      const delay = 700 + Math.random() * 400;
      escTimer = setTimeout(() => {
        if (!autoEnabled) {
          actionInFlight = false;
          return;
        }
        if (lastEscWord !== lastWord) {
          actionInFlight = false;
          return;
        }
        if (Date.now() - lastEscTime < ESC_COOLDOWN) {
          actionInFlight = false;
          return;
        }
        lastEscTime = Date.now();
        sendEscape();
        setTimeout(() => {
          actionInFlight = false;
        }, 3500);
      }, delay);
    }

    function detectSubmitFailed(attemptedWord) {
      const current = findCurrentWord();
      if (current && normWord(current) === normWord(lastWord)) return true;
      const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
      if (input && input.value && normWord(input.value) === normWord(attemptedWord)) return true;
      const errEl = Array.from(document.querySelectorAll('div, span, p')).find(el => {
        if (el.closest('#noitu-helper') || el.closest('#noitu-helper-2')) return false;
        const t = (el.innerText || el.textContent || '').trim().toLowerCase();
        return t && /không tồn tại|không hợp lệ|không có trong|sai|lỗi|invalid|not found/.test(t) && t.length < 80;
      });
      if (errEl) return true;
      return false;
    }

    function performSubmit(full, el, fromAuto = false) {
      lastAttemptedWord = full;
      justSubmittedByMe = true;
      usedWords.add(full);
      actionInFlight = true;
      autoPasteAndSubmit(full);
      if (el) {
        const oldBg = el.style.background;
        const textEl = el.querySelector('.sugg-text');
        el.style.background = 'linear-gradient(135deg,#10b981,#059669)';
        if (textEl) textEl.style.color = 'white';
        setTimeout(() => { el.style.background = oldBg; }, 450);
      }
      if (!fromAuto) {
        setTimeout(() => {
          actionInFlight = false;
        }, 650);
      }
      clearTimeout(checkAcceptTimer);
      const failCheckDelay = fromAuto ? 5000 : 3200;
      checkAcceptTimer = setTimeout(() => {
        if (lastAttemptedWord && detectSubmitFailed(lastAttemptedWord)) {
          setTimeout(() => {
            if (!lastAttemptedWord) return;
            if (detectSubmitFailed(lastAttemptedWord)) {
              markAsBad(lastAttemptedWord);
              usedWords.delete(lastAttemptedWord);
              justSubmittedByMe = false;
              actionInFlight = false;
              suggest(lastWord);
              if (fromAuto && autoEnabled) {
                setTimeout(() => {
                  if (autoEnabled) tryAutoPlay();
                }, 600);
              }
            } else {
              if (fromAuto) actionInFlight = false;
            }
          }, 1300);
        } else {
          if (fromAuto) actionInFlight = false;
        }
      }, failCheckDelay);
    }

    function tryAutoPlay() {
      if (!autoEnabled || !isReady) return;
      if (actionInFlight) return;
      clearTimeout(autoTimer);
      clearTimeout(checkAcceptTimer);
      clearTimeout(escTimer);
      const chips = resultEl.querySelectorAll('.sugg');
      if (!chips.length) {
        scheduleEscape();
        return;
      }
      let best = null;
      for (const el of chips) {
        if (el.dataset.kind === 'dead') { best = el; break; }
      }
      if (!best) {
        for (const el of chips) {
          if (el.dataset.kind === 'trap') { best = el; break; }
        }
      }
      if (!best) {
        for (const el of chips) {
          if (el.dataset.kind === 'ok') { best = el; break; }
        }
      }
      if (!best) {
        for (const el of chips) {
          if (el.dataset.kind === 'risk') { best = el; break; }
        }
      }
      if (!best) {
        scheduleEscape();
        return;
      }
      const delay = 60 + Math.random() * 120;
      actionInFlight = true;
      autoTimer = setTimeout(() => {
        if (!autoEnabled) { actionInFlight = false; return; }
        const full = best.dataset.full;
        performSubmit(full, best, true);
      }, delay);
    }

    function suggest(word) {
      if (!word) {
        currentEl.textContent = 'Chưa tìm thấy từ';
        resultEl.innerHTML = '';
        if (autoEnabled) scheduleEscape();
        return;
      }
      currentEl.textContent = word;
      if (!isReady) {
        resultEl.innerHTML = `<div style="color:#d97706;font-size:13px;padding:8px 0;">Đang tải từ điển...</div>`;
        return;
      }
      const key = getLastSyllable(word);
      const curNorm = normWord(word);
      const allForKey = byFirst.get(key) || [];
      const seenAvail = new Set();
      const available = [];
      for (const w of allForKey) {
        if (w === curNorm) continue;
        if (usedWords.has(w) || allSeenWords.has(w) || badWords.has(w)) continue;
        if (seenAvail.has(w)) continue;
        seenAvail.add(w);
        available.push(w);
      }
      if (!available.length) {
        resultEl.innerHTML = `<div style="color:#d97706;font-size:13px;padding:8px 0;">Hết từ · Đang bỏ qua...</div>`;
        if (autoEnabled) scheduleEscape();
        return;
      }
      const traps = [], deads = [], risks = [], oks = [];
      available.forEach(full => {
        if (trapSet.has(full)) {
          traps.push(full);
        } else if (isDeadEndWord(full)) {
          deads.push(full);
        } else if (isRiskyTrap(full)) {
          risks.push(full);
        } else {
          oks.push(full);
        }
      });
      const byCont = (a, b) => contCountOf(a) - contCountOf(b);
      traps.sort(byCont);
      deads.sort(byCont);
      risks.sort(byCont);
      oks.sort(byCont);
      const lim = isMobile ? 12 : 20;
      resultEl.innerHTML =
        sectionHtml('★ Nên dùng (bẫy)', '#b45309', traps.slice(0, lim), 'trap') +
        sectionHtml('✗ Cụt — hết đường', '#be123c', deads.slice(0, lim), 'dead') +
        sectionHtml('Gợi ý thường', '#059669', oks.slice(0, lim), 'ok') +
        sectionHtml('✗ Không nên dùng', '#c2410c', risks.slice(0, lim), 'risk');

      resultEl.querySelectorAll('.sugg').forEach(el => {
        el.onmouseenter = () => {
          const full = el.dataset.full;
          const nextKey = getLastSyllable(full);
          const nextSeen = new Set();
          const nextList = [];
          for (const w of (byFirst.get(nextKey) || [])) {
            if (usedWords.has(w) || allSeenWords.has(w) || badWords.has(w)) continue;
            if (nextSeen.has(w)) continue;
            nextSeen.add(w);
            nextList.push(w);
          }
          if (!nextList.length) {
            tooltip.innerHTML = `<div style="opacity:.75">Không còn từ nối tiếp sau "<b>${nextKey}</b>"</div>`;
          } else {
            const nextTraps = [], nextDeads = [], nextRisks = [], nextOks = [];
            nextList.forEach(w => {
              if (trapSet.has(w)) nextTraps.push(w);
              else if (isDeadEndWord(w)) nextDeads.push(w);
              else if (isRiskyTrap(w)) nextRisks.push(w);
              else nextOks.push(w);
            });
            let html = `<div style="font-weight:700;margin-bottom:8px;color:#6ee7b7">Nối tiếp sau "<b>${nextKey}</b>" (${nextList.length})</div>`;
            if (nextTraps.length) {
              html += `<div style="color:#fbbf24;margin:6px 0 3px;font-weight:600">★ Bẫy:</div>`;
              html += nextTraps.slice(0, 7).map(w => `<div style="opacity:0.9">• ${w}</div>`).join('');
            }
            if (nextDeads.length) {
              html += `<div style="color:#f87171;margin:6px 0 3px;font-weight:600">✗ Cụt:</div>`;
              html += nextDeads.slice(0, 5).map(w => `<div style="opacity:0.9">• ${w}</div>`).join('');
            }
            if (nextRisks.length) {
              html += `<div style="color:#fb923c;margin:6px 0 3px;font-weight:600">✗ Không nên:</div>`;
              html += nextRisks.slice(0, 5).map(w => `<div style="opacity:0.9">• ${w}</div>`).join('');
            }
            if (nextOks.length) {
              html += `<div style="color:#86efac;margin:6px 0 3px;font-weight:600">Thường:</div>`;
              html += nextOks.slice(0, 8).map(w => `<div style="opacity:0.9">• ${w}</div>`).join('');
            }
            tooltip.innerHTML = html;
          }
          const rect = el.getBoundingClientRect();
          tooltip.style.display = 'block';
          let left = rect.left;
          if (left + 300 > window.innerWidth) left = window.innerWidth - 310;
          if (left < 6) left = 6;
          tooltip.style.left = left + 'px';
          tooltip.style.top = (rect.bottom + 10) + 'px';
        };
        el.onmouseleave = () => {
          tooltip.style.display = 'none';
        };
        el.onclick = () => {
          if (actionInFlight && autoEnabled) return;
          const full = el.dataset.full;
          performSubmit(full, el, false);
          tooltip.style.display = 'none';
        };
      });

      if (autoEnabled) tryAutoPlay();
    }

    function autoPasteAndSubmit(text) {
      const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
      if (!input) return;
      fillEditable(input, text);
      input.focus();
      setTimeout(() => {
        const btn = document.querySelector('button[class*="submitBtn"], button[class*="submit"]') ||
                    Array.from(document.querySelectorAll('button')).find(b => b.querySelector('svg'));
        if (btn) btn.click();
        else {
          input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, bubbles: true }));
          input.dispatchEvent(new KeyboardEvent('keyup', { key: 'Enter', code: 'Enter', keyCode: 13, bubbles: true }));
        }
      }, 150);
    }

    function fillEditable(el, text) {
      try {
        el.focus();
        const proto = el.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
        const setter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;
        if (setter) setter.call(el, text); else el.value = text;
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
      } catch (e) { return false; }
    }

    function tick() {
      const word = findCurrentWord();
      if (word && word !== lastWord) {
        const norm = normWord(word);
        const isTwoSyllable = norm && norm.split(' ').length === 2;
        if (isTwoSyllable && !justSubmittedByMe) {
          markAsNewFromOpponent(norm);
        }
        justSubmittedByMe = false;
        if (isTwoSyllable) allSeenWords.add(norm);
        lastWord = word;
        lastEscWord = null;
        lastAttemptedWord = null;
        actionInFlight = false;
        clearTimeout(checkAcceptTimer);
        clearTimeout(escTimer);
        clearTimeout(autoTimer);
        suggest(word);
      }
    }

    // ===== Kéo thả di chuyển =====
    function attachDrag(panelEl, headerEl, savePosFn, excludeSelectors) {
      let dragging = false, ox = 0, oy = 0;
      function start(x, y, target) {
        if (excludeSelectors.some(sel => target.closest(sel))) return false;
        const rect = panelEl.getBoundingClientRect();
        ox = x - rect.left;
        oy = y - rect.top;
        panelEl.style.left = rect.left + 'px';
        panelEl.style.top = rect.top + 'px';
        panelEl.style.right = 'auto';
        panelEl.style.bottom = 'auto';
        return true;
      }
      function move(x, y) {
        const w = panelEl.offsetWidth, h = panelEl.offsetHeight;
        let left = Math.max(4, Math.min(window.innerWidth - w - 4, x - ox));
        let top = Math.max(4, Math.min(window.innerHeight - h - 4, y - oy));
        panelEl.style.left = left + 'px';
        panelEl.style.top = top + 'px';
        savePosFn(panelEl.style.left, panelEl.style.top);
      }
      panelEl.addEventListener('mousedown', e => { dragging = start(e.clientX, e.clientY, e.target); });
      document.addEventListener('mousemove', e => { if (dragging) move(e.clientX, e.clientY); });
      document.addEventListener('mouseup', () => dragging = false);
      headerEl.addEventListener('touchstart', e => {
        dragging = start(e.touches[0].clientX, e.touches[0].clientY, e.target);
      }, { passive: true });
      panelEl.addEventListener('touchmove', e => {
        if (!dragging) return;
        move(e.touches[0].clientX, e.touches[0].clientY);
        e.preventDefault();
      }, { passive: false });
      panelEl.addEventListener('touchend', () => dragging = false);
    }

    // ===== RESIZE (4 góc + 4 cạnh) =====
    function attachResize(panelEl, saveSizeFn, isPanel1 = true) {
      const directions = ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'];
      const handles = {};

      directions.forEach(dir => {
        const handle = document.createElement('div');
        handle.className = `noitu-resize-handle noitu-rh-${dir}`;
        handle.dataset.dir = dir;
        panelEl.appendChild(handle);
        handles[dir] = handle;
      });

      let resizing = false;
      let startX, startY, startW, startH, startL, startT, dir;

      const minW = parseInt(panelEl.style.minWidth) || 240;
      const minH = parseInt(panelEl.style.minHeight) || 160;

      function onStart(e, direction) {
        e.preventDefault();
        e.stopPropagation();
        resizing = true;
        dir = direction;
        const rect = panelEl.getBoundingClientRect();
        startX = e.clientX || (e.touches && e.touches[0].clientX);
        startY = e.clientY || (e.touches && e.touches[0].clientY);
        startW = rect.width;
        startH = rect.height;
        startL = rect.left;
        startT = rect.top;

        panelEl.style.left = startL + 'px';
        panelEl.style.top = startT + 'px';
        panelEl.style.right = 'auto';
        panelEl.style.bottom = 'auto';
        panelEl.style.maxWidth = 'none';
      }

      function onMove(e) {
        if (!resizing) return;
        e.preventDefault();
        const x = e.clientX || (e.touches && e.touches[0].clientX);
        const y = e.clientY || (e.touches && e.touches[0].clientY);
        const dx = x - startX;
        const dy = y - startY;

        let newW = startW;
        let newH = startH;
        let newL = startL;
        let newT = startT;

        if (dir.includes('e')) newW = Math.max(minW, startW + dx);
        if (dir.includes('w')) {
          newW = Math.max(minW, startW - dx);
          newL = startL + (startW - newW);
        }
        if (dir.includes('s')) newH = Math.max(minH, startH + dy);
        if (dir.includes('n')) {
          newH = Math.max(minH, startH - dy);
          newT = startT + (startH - newH);
        }

        // Giới hạn không vượt ra ngoài màn hình
        if (newL < 4) {
          newW -= (4 - newL);
          newL = 4;
        }
        if (newT < 4) {
          newH -= (4 - newT);
          newT = 4;
        }
        if (newL + newW > window.innerWidth - 4) {
          newW = window.innerWidth - 4 - newL;
        }
        if (newT + newH > window.innerHeight - 4) {
          newH = window.innerHeight - 4 - newT;
        }

        panelEl.style.width = newW + 'px';
        panelEl.style.height = newH + 'px';
        panelEl.style.left = newL + 'px';
        panelEl.style.top = newT + 'px';
      }

      function onEnd() {
        if (!resizing) return;
        resizing = false;

        // Lưu kích thước
        saveSizeFn(panelEl.style.width, panelEl.style.height);

        // Cập nhật chiều cao mở rộng nếu đang không thu gọn
        if (isPanel1) {
          if (!collapsed) expandedHeight1 = panelEl.style.height;
          savePosition(panelEl.style.left, panelEl.style.top);
        } else {
          if (!collapsed2) expandedHeight2 = panelEl.style.height;
          savePosition2(panelEl.style.left, panelEl.style.top);
        }
      }

      directions.forEach(d => {
        const h = handles[d];
        h.addEventListener('mousedown', e => onStart(e, d));
        h.addEventListener('touchstart', e => onStart(e, d), { passive: false });
      });

      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onEnd);
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onEnd);
    }

    // Gắn drag + resize
    attachDrag(panel, headerEl, savePosition, ['.sugg', '#noitu-toggle', '#noitu-auto', '#noitu-clear', '.noitu-resize-handle']);
    attachDrag(panel2, header2El, savePosition2, ['#noitu-toggle2', '#noitu-clear-bad', '#noitu-clear-new', '#noitu-copy-new', '.noitu-resize-handle']);

    attachResize(panel, saveSize, true);    // bảng 1
    attachResize(panel2, saveSize2, false); // bảng 2

    tick();
    if (!window.__noituTickInterval) window.__noituTickInterval = setInterval(tick, 1100);
  }

  createHelper();
  if (!window.__noituWatchdog) {
    window.__noituWatchdog = setInterval(() => {
      if (!document.getElementById(HELPER_ID) || !document.getElementById(HELPER2_ID)) createHelper();
    }, 1500);
  }
})();
