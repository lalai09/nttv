// ==UserScript==
// @name         Bảng Nhận Diện Từ + Gợi Ý - noitu.fun (Mobile Fixed)
// @namespace    http://tampermonkey.net/
// @version      5.0
// @description  Bảng hiển thị cố định góc trên điện thoại: nhận diện từ hiện tại + gợi ý từ nối từ kho từ Firebase
// @author       You
// @match        https://*.noitu.fun/*
// @match        https://noitu.fun/*
// @run-at       document-end
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const FIREBASE_DB_URL = "https://khotu-fc3e7-default-rtdb.asia-southeast1.firebasedatabase.app";
    const byFirst = new Map();
    const trapSet = new Set();
    let totalValidWords = 0;
    let dictReady = false;

    function normWord(w) {
        return (w || '').trim().toLowerCase().replace(/\s+/g, ' ');
    }

    function buildIndex(entries) {
        byFirst.clear();
        trapSet.clear();
        const validSet = new Set();
        for (const entry of entries) {
            const word = (typeof entry === 'string') ? entry : entry.w;
            const trap = (typeof entry === 'object' && entry) ? !!entry.trap : false;
            if (!word) continue;
            const norm = normWord(word);
            const parts = norm.split(' ');
            if (parts.length !== 2) continue;
            validSet.add(norm);
            if (trap) trapSet.add(norm);
            const first = parts[0];
            if (!byFirst.has(first)) byFirst.set(first, []);
            byFirst.get(first).push(norm);
        }
        totalValidWords = validSet.size;
    }

    function loadWords() {
        fetch(`${FIREBASE_DB_URL}/words.json`)
            .then(r => r.json())
            .then(data => {
                const entries = data ? Object.values(data) : [];
                buildIndex(entries);
                dictReady = true;
                updateDictStatus();
                if (lastText) renderSuggestions(lastText);
            })
            .catch(() => {
                dictReady = false;
                updateDictStatus();
            });
    }

    function updateDictStatus() {
        const statusEl = document.getElementById('wd-status');
        if (!statusEl) return;
        if (dictReady) {
            statusEl.textContent = `Sẵn sàng (${totalValidWords.toLocaleString('vi-VN')})`;
            statusEl.style.color = '#00ffcc';
        } else {
            statusEl.textContent = 'Lỗi tải kho từ';
            statusEl.style.color = '#ff5577';
        }
    }

    function isDeadEndWord(word, badWords) {
        const ns = word.split(' ')[1];
        const opts = byFirst.get(ns) || [];
        return opts.filter(w => w !== word && !badWords.has(w) && !usedWords.has(w)).length === 0;
    }

    function isRiskyTrap(word, badWords) {
        const ns = word.split(' ')[1];
        const opts = byFirst.get(ns) || [];
        const available = opts.filter(w => !badWords.has(w) && !usedWords.has(w));
        if (!available.length) return null;
        if (available.some(w => isDeadEndWord(w, badWords))) return 'risk-dead';
        if (available.some(w => trapSet.has(w))) return 'risk-trap';
        return null;
    }

    function loadBadWords() {
        try {
            const raw = localStorage.getItem('wd_bad_words');
            return raw ? new Set(JSON.parse(raw)) : new Set();
        } catch (e) { return new Set(); }
    }
    function saveBadWords(set) {
        try { localStorage.setItem('wd_bad_words', JSON.stringify([...set])); } catch (e) {}
    }
    const badWords = loadBadWords();

    function initUI() {
        if (document.getElementById('wd-mobile-panel')) return;

        const panel = document.createElement('div');
        panel.id = 'wd-mobile-panel';
        panel.style.cssText = `
            position: fixed !important;
            top: 5px !important;
            left: 5% !important;
            width: 90% !important;
            z-index: 9999999 !important;
            background: #111111 !important;
            border: 2px solid #00ffcc !important;
            border-radius: 10px !important;
            padding: 8px !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.8) !important;
            font-family: sans-serif !important;
            color: #ffffff !important;
            text-align: center !important;
            box-sizing: border-box !important;
        `;

        panel.innerHTML = `
            <div id="wd-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;cursor:grab;">
                <div style="font-size: 11px; color: #888; font-weight: bold;">TOOL NHẬN DIỆN NỐI TỪ</div>
                <div style="display:flex;align-items:center;gap:6px;">
                    <button id="wd-auto" style="border:none;border-radius:6px;padding:2px 7px;font-size:10px;font-weight:700;cursor:pointer;background:#333;color:#ccc;">Tự động</button>
                    <button id="wd-clear" style="border:none;background:#fef2f2;color:#b91c1c;border-radius:6px;padding:2px 7px;font-size:10px;font-weight:700;cursor:pointer;">Xóa</button>
                    <div id="wd-status" style="font-size: 10px; color: #d97706; font-weight: bold;">Đang tải...</div>
                    <button id="wd-toggle" style="border:none;background:#00ffcc;color:#000;border-radius:6px;width:20px;height:20px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;">−</button>
                </div>
            </div>
            <div id="wd-body">
                <table style="width: 100%; border-collapse: collapse; margin-top: 2px;">
                    <thead>
                        <tr style="background: #00ffcc; color: #000; font-size: 12px; font-weight: bold;">
                            <th style="padding: 4px; border: 1px solid #333;">Từ gốc</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="wd-original" style="padding: 6px; border: 1px solid #333; color: #ff0; font-size: 16px; font-weight: bold;">Chờ từ...</td>
                        </tr>
                    </tbody>
                </table>
                <div id="wd-suggest" style="display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin-top:8px;max-height:32vh;overflow-y:auto;"></div>
            </div>
        `;

        document.body.appendChild(panel);
        attachDrag(panel, panel.querySelector('#wd-header'));
        attachToggle(panel);
        attachAutoButton(panel);
        attachClearButton(panel);
    }

    function loadPos() {
        try {
            const raw = localStorage.getItem('wd_panel_pos');
            return raw ? JSON.parse(raw) : null;
        } catch (e) { return null; }
    }
    function savePos(left, top) {
        try { localStorage.setItem('wd_panel_pos', JSON.stringify({ left, top })); } catch (e) {}
    }
    function loadCollapsed() {
        try { return localStorage.getItem('wd_panel_collapsed') === '1'; } catch (e) { return false; }
    }
    function saveCollapsed(on) {
        try { localStorage.setItem('wd_panel_collapsed', on ? '1' : '0'); } catch (e) {}
    }

    function attachToggle(panel) {
        const toggleBtn = panel.querySelector('#wd-toggle');
        const bodyEl = panel.querySelector('#wd-body');
        let collapsed = loadCollapsed();
        function apply() {
            bodyEl.style.display = collapsed ? 'none' : 'block';
            toggleBtn.textContent = collapsed ? '+' : '−';
            saveCollapsed(collapsed);
        }
        apply();
        toggleBtn.addEventListener('click', e => {
            e.stopPropagation();
            collapsed = !collapsed;
            apply();
        });
    }

    function attachDrag(panel, header) {
        const saved = loadPos();
        if (saved && saved.left && saved.top) {
            panel.style.setProperty('left', saved.left, 'important');
            panel.style.setProperty('top', saved.top, 'important');
            panel.style.setProperty('right', 'auto', 'important');
        }

        let dragging = false, ox = 0, oy = 0;
        function start(x, y, target) {
            if (target.closest('#wd-toggle')) return false;
            const rect = panel.getBoundingClientRect();
            ox = x - rect.left;
            oy = y - rect.top;
            panel.style.setProperty('left', rect.left + 'px', 'important');
            panel.style.setProperty('top', rect.top + 'px', 'important');
            panel.style.setProperty('right', 'auto', 'important');
            return true;
        }
        function move(x, y) {
            const w = panel.offsetWidth, h = panel.offsetHeight;
            let left = Math.max(4, Math.min(window.innerWidth - w - 4, x - ox));
            let top = Math.max(4, Math.min(window.innerHeight - h - 4, y - oy));
            panel.style.setProperty('left', left + 'px', 'important');
            panel.style.setProperty('top', top + 'px', 'important');
            savePos(panel.style.left, panel.style.top);
        }
        header.addEventListener('mousedown', e => { dragging = start(e.clientX, e.clientY, e.target); });
        document.addEventListener('mousemove', e => { if (dragging) move(e.clientX, e.clientY); });
        document.addEventListener('mouseup', () => dragging = false);
        header.addEventListener('touchstart', e => {
            dragging = start(e.touches[0].clientX, e.touches[0].clientY, e.target);
        }, { passive: true });
        panel.addEventListener('touchmove', e => {
            if (!dragging) return;
            move(e.touches[0].clientX, e.touches[0].clientY);
            e.preventDefault();
        }, { passive: false });
        panel.addEventListener('touchend', () => dragging = false);
    }

    let autoEnabled = (function () {
        try { return localStorage.getItem('wd_auto') === '1'; } catch (e) { return false; }
    })();
    function saveAuto(on) {
        try { localStorage.setItem('wd_auto', on ? '1' : '0'); } catch (e) {}
    }
    let lastSubmitted = null;
    let autoTimer = null;
    const usedWords = new Set();
    let lastSkippedWord = null;
    let skipTimer = null;

    function sendSkip() {
        const skipBtn = Array.from(document.querySelectorAll('button')).find(b =>
            /bỏ qua|skip|pass/i.test((b.textContent || '').trim())
        );
        if (skipBtn) {
            skipBtn.click();
        } else {
            const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
            const targets = [input, document].filter(Boolean);
            targets.forEach(target => {
                target.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
                target.dispatchEvent(new KeyboardEvent('keyup', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
            });
        }
    }

    function attachAutoButton(panel) {
        const btn = panel.querySelector('#wd-auto');
        function apply() {
            if (autoEnabled) {
                btn.style.background = '#059669';
                btn.style.color = '#fff';
                btn.textContent = 'Tự động: Bật';
            } else {
                btn.style.background = '#333';
                btn.style.color = '#ccc';
                btn.textContent = 'Tự động';
            }
        }
        apply();
        btn.addEventListener('click', e => {
            e.stopPropagation();
            autoEnabled = !autoEnabled;
            saveAuto(autoEnabled);
            apply();
            if (autoEnabled && lastText) tryAutoPlay();
        });
    }

    function fillAndSubmit(full) {
        lastSubmitted = full;
        usedWords.add(full);
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(full).catch(() => {});
        }
        const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
        if (!input) return;
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
        if (setter) setter.call(input, full);
        else input.value = full;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();

        setTimeout(() => {
            let sendBtn =
                document.querySelector('button[class*="submitBtn"], button[class*="submit"]') ||
                Array.from(document.querySelectorAll('button')).find(b =>
                    b.querySelector('svg') ||
                    /gửi|submit|ok|xác nhận|gửi từ/i.test((b.textContent || '').trim())
                );
            if (sendBtn) {
                sendBtn.click();
            } else {
                ['keydown', 'keypress', 'keyup'].forEach(type => {
                    input.dispatchEvent(new KeyboardEvent(type, {
                        key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true
                    }));
                });
            }
        }, 60);
    }

    function tryAutoPlay() {
        if (!autoEnabled) return;
        clearTimeout(autoTimer);
        const box = document.getElementById('wd-suggest');
        if (!box) return;
        // Ưu tiên: cụt -> bẫy -> thường -> không nên dùng
        const priority = ['dead', 'trap', 'ok', 'risk-trap', 'risk-dead'];
        let best = null;
        for (const kind of priority) {
            best = box.querySelector(`.wd-sugg[data-kind="${kind}"]`);
            if (best) break;
        }
        if (!best) return;
        const full = best.dataset.full;
        const delay = 250 + Math.random() * 250;
        autoTimer = setTimeout(() => {
            if (!autoEnabled) return;
            fillAndSubmit(full);
        }, delay);
    }

    function attachClearButton(panel) {
        const btn = panel.querySelector('#wd-clear');
        btn.addEventListener('click', e => {
            e.stopPropagation();
            usedWords.clear();
            badWords.clear();
            saveBadWords(badWords);
            lastSkippedWord = null;
            clearTimeout(autoTimer);
            clearTimeout(skipTimer);
            const statusEl = document.getElementById('wd-status');
            if (statusEl) {
                statusEl.textContent = 'Đã xóa phiên';
                statusEl.style.color = '#d97706';
                setTimeout(updateDictStatus, 1200);
            }
            if (lastText) renderSuggestions(lastText);
        });
    }

    function chip(full, kind) {
        const second = full.split(' ')[1];
        const styles = {
            trap: { bg: 'rgba(255,140,0,.22)', border: '#ff8c00', color: '#ffb84d', mark: '★ ' },
            dead: { bg: 'rgba(255,92,122,.15)', border: '#ff5c7a', color: '#ff8fa3', mark: '✓ ' },
            'risk-trap': { bg: 'rgba(255,215,0,.22)', border: '#ffd700', color: '#fff0a3', mark: '✗ ' },
            'risk-dead': { bg: 'rgba(147,112,219,.20)', border: '#9370db', color: '#c9a9ff', mark: '✗ ' },
            ok:   { bg: 'rgba(0,255,204,.10)', border: '#00ffcc', color: '#e6fffb', mark: '' }
        };
        const s = styles[kind] || styles.ok;
        return `<div class="wd-sugg" data-full="${full}" data-kind="${kind}"
            style="padding:6px 10px;background:${s.bg};border:1.5px solid ${s.border};
                   border-radius:999px;font-size:13px;font-weight:600;color:${s.color};cursor:pointer;">
            ${s.mark}${second}
        </div>`;
    }

    function renderSuggestions(text) {
        const box = document.getElementById('wd-suggest');
        if (!box) return;

        if (!dictReady) {
            box.innerHTML = `<div style="color:#d97706;font-size:12px;">Đang tải kho từ...</div>`;
            return;
        }

        const norm = normWord(text);
        const parts = norm.split(' ');
        if (parts.length !== 2) {
            box.innerHTML = `<div style="color:#888;font-size:12px;">Từ không hợp lệ (2 âm tiết)</div>`;
            return;
        }

        const key = parts[1];
        const available = (byFirst.get(key) || []).filter(w => w !== norm && !badWords.has(w) && !usedWords.has(w));

        if (!available.length) {
            box.innerHTML = `<div style="color:#ff5577;font-size:12px;">Hết từ nối cho "${key}"</div>`;
            if (autoEnabled && lastSkippedWord !== norm) {
                lastSkippedWord = norm;
                clearTimeout(skipTimer);
                skipTimer = setTimeout(() => {
                    if (autoEnabled && lastText && normWord(lastText) === norm) {
                        sendSkip();
                    }
                }, 300 + Math.random() * 300);
            }
            return;
        }

        const traps = [], deads = [], riskTraps = [], riskDeads = [], oks = [];
        available.forEach(w => {
            if (trapSet.has(w)) traps.push(w);
            else if (isDeadEndWord(w, badWords)) deads.push(w);
            else {
                const risk = isRiskyTrap(w, badWords);
                if (risk === 'risk-trap') riskTraps.push(w);
                else if (risk === 'risk-dead') riskDeads.push(w);
                else oks.push(w);
            }
        });

        const lim = 14;
        box.innerHTML =
            traps.slice(0, lim).map(w => chip(w, 'trap')).join('') +
            deads.slice(0, lim).map(w => chip(w, 'dead')).join('') +
            oks.slice(0, lim).map(w => chip(w, 'ok')).join('') +
            riskTraps.slice(0, lim).map(w => chip(w, 'risk-trap')).join('') +
            riskDeads.slice(0, lim).map(w => chip(w, 'risk-dead')).join('');

        box.querySelectorAll('.wd-sugg').forEach(el => {
            el.onclick = () => {
                const full = el.dataset.full;
                fillAndSubmit(full);
                el.style.background = '#059669';
            };
        });

        if (autoEnabled) tryAutoPlay();
    }

    let lastText = "";

    function scanWord() {
        initUI();

        const allTextElements = document.querySelectorAll('*');
        let matchedText = "";

        for (let el of allTextElements) {
            if (el.closest('#wd-mobile-panel')) continue;
            if (el.children.length === 0 && el.innerText) {
                const text = el.innerText.trim();

                if (
                    text.length >= 2 &&
                    !text.includes('\n') &&
                    !['ĐIỂM', 'Đối thủ', 'Bỏ qua', 'ĐÃ NỐI', 'esc', 'Bot', 'Chơi', 'nhóm'].some(k => text.includes(k)) &&
                    !/^\d+$/.test(text)
                ) {
                    const style = window.getComputedStyle(el);
                    if (parseFloat(style.fontSize) >= 20 && el.getBoundingClientRect().height > 0) {
                        matchedText = text;
                    }
                }
            }
        }

        if (matchedText && matchedText !== lastText) {
            lastText = matchedText;

            const norm = normWord(matchedText);
            if (norm && norm.split(' ').length === 2) {
                usedWords.add(norm);
            }

            const origEl = document.getElementById('wd-original');
            if (origEl) {
                origEl.innerText = matchedText;
            }

            renderSuggestions(matchedText);
        }
    }

    setTimeout(initUI, 1000);
    loadWords();
    setInterval(loadWords, 15000);
    setInterval(scanWord, 200);
})();
