// ==UserScript==
// @name         Nối Từ Helper Mobile (noitu.fun)
// @namespace    http://tampermonkey.net/
// @version      1.1-mobile
// @description  Bản điện thoại: chỉ nút Tự chọn + tự dán/gửi + chặn bàn phím ảo (đã sửa nhận diện từ)
// @author       You
// @match        https://www.noitu.fun/*
// @match        https://noitu.fun/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  const HELPER_ID = 'noitu-helper-mobile';
  const AUTO_KEY = 'noitu_helper_auto_mobile';
  const BAD_KEY = 'noitu_helper_bad_words';
  const POS_KEY = 'noitu_helper_pos_mobile';

  function loadJSON(key) {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }
  function saveJSON(key, val) {
    try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {}
  }
  function loadAuto() {
    try { return localStorage.getItem(AUTO_KEY) === '1'; } catch (e) { return false; }
  }
  function saveAuto(on) {
    try { localStorage.setItem(AUTO_KEY, on ? '1' : '0'); } catch (e) {}
  }
  function loadBadWords() {
    try {
      const raw = localStorage.getItem(BAD_KEY);
      return raw ? new Set(JSON.parse(raw)) : new Set();
    } catch (e) { return new Set(); }
  }
  function saveBadWords(set) {
    saveJSON(BAD_KEY, [...set]);
  }
  function loadPosition() { return loadJSON(POS_KEY); }
  function savePosition(left, top) { saveJSON(POS_KEY, { left, top }); }

  function createHelper() {
    if (document.getElementById(HELPER_ID)) return;

    let autoEnabled = loadAuto();
    const usedWords = new Set();
    const allSeenWords = new Set();
    const badWords = loadBadWords();

    // ===== UI =====
    const panel = document.createElement('div');
    panel.id = HELPER_ID;
    panel.innerHTML = `
      <div id="noitu-m-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:grab;">
        <div style="font-weight:700;font-size:14px;white-space:nowrap;">🧠 Auto</div>
        <button id="noitu-m-auto" style="border:none;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:700;cursor:pointer;min-width:96px;"></button>
        <div id="noitu-m-status" style="font-size:11px;color:#10b981;min-width:90px;text-align:right;line-height:1.25;">...</div>
      </div>
      <div id="noitu-m-current" style="margin-top:6px;font-size:12px;color:#065f46;text-align:center;font-weight:600;min-height:18px;"></div>
    `;

    Object.assign(panel.style, {
      position: 'fixed',
      background: '#ffffff',
      border: '2px solid #10b981',
      borderRadius: '14px',
      padding: '10px 12px',
      zIndex: '999999',
      boxShadow: '0 8px 28px rgba(16,185,129,0.28)',
      fontFamily: 'system-ui, -apple-system, sans-serif',
      userSelect: 'none',
      touchAction: 'none',
      boxSizing: 'border-box',
      left: '8px',
      right: '8px',
      bottom: '12px',
      top: 'auto',
      maxWidth: '420px',
      margin: '0 auto'
    });

    const savedPos = loadPosition();
    if (savedPos && savedPos.left && savedPos.top) {
      panel.style.left = savedPos.left;
      panel.style.top = savedPos.top;
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    }

    document.body.appendChild(panel);

    const autoBtn = document.getElementById('noitu-m-auto');
    const statusEl = document.getElementById('noitu-m-status');
    const currentEl = document.getElementById('noitu-m-current');
    const headerEl = document.getElementById('noitu-m-header');

    function updateAutoBtn() {
      if (autoEnabled) {
        autoBtn.style.background = '#059669';
        autoBtn.style.color = '#fff';
        autoBtn.textContent = 'Tự chọn: BẬT';
      } else {
        autoBtn.style.background = '#f3f4f6';
        autoBtn.style.color = '#374151';
        autoBtn.textContent = 'Tự chọn';
      }
    }
    updateAutoBtn();

    // ===== Kho từ =====
    const FIREBASE_DB_URL = "https://khotu-fc3e7-default-rtdb.asia-southeast1.firebasedatabase.app";
    const byFirst = new Map();
    const contCount = new Map();
    const trapSet = new Set();
    let lastWord = '';
    let isReady = false;
    let autoTimer = null;
    let checkAcceptTimer = null;
    let escTimer = null;
    let actionInFlight = false;
    let lastAttemptedWord = null;
    let justSubmittedByMe = false;

    statusEl.textContent = 'Tải từ...';
    statusEl.style.color = '#d97706';

    function normWord(w) {
      return (w || '').trim().toLowerCase().replace(/\s+/g, ' ');
    }
    function lastSyllable(w) {
      return normWord(w).split(' ').pop();
    }
    function getLastSyllable(text) {
      if (!text) return '';
      return normWord(String(text).replace(/[.,!?]/g, '')).split(' ').pop() || '';
    }
    function isValidTwoSyllable(text) {
      if (!text) return false;
      text = String(text).trim().toLowerCase();
      return /^[a-záàảãạăắằẳẵặâấầẩẫậéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵđ]+ [a-záàảãạăắằẳẵặâấầẩẫậéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵđ]+$/i.test(text);
    }

    function buildIndex(entries) {
      byFirst.clear();
      contCount.clear();
      trapSet.clear();
      for (const entry of entries) {
        const word = (typeof entry === 'string') ? entry : entry.w;
        const trap = (typeof entry === 'object' && entry) ? !!entry.trap : false;
        if (!word) continue;
        const norm = normWord(word);
        if (trap) trapSet.add(norm);
        const parts = norm.split(' ');
        if (parts.length !== 2) continue;
        const first = parts[0];
        if (!byFirst.has(first)) byFirst.set(first, []);
        byFirst.get(first).push(norm);
      }
      for (const [k, arr] of byFirst) {
        contCount.set(k, arr.length);
      }
    }

    function loadWords() {
      fetch(`${FIREBASE_DB_URL}/words.json`)
        .then(r => r.json())
        .then(data => {
          const entries = data ? Object.values(data) : [];
          buildIndex(entries);
          isReady = true;
          statusEl.textContent = `OK (${byFirst.size})`;
          statusEl.style.color = '#10b981';
          if (autoEnabled && lastWord) tryAutoPlay();
        })
        .catch(() => {
          isReady = false;
          statusEl.textContent = 'Lỗi kho';
          statusEl.style.color = '#dc2626';
        });
    }
    loadWords();
    setInterval(loadWords, 20000);

    function contCountOf(word) {
      return contCount.get(lastSyllable(word)) || 0;
    }
    function isDeadEndWord(word) {
      const ns = lastSyllable(word);
      const opts = byFirst.get(ns) || [];
      return opts.filter(w => w !== word && !usedWords.has(w) && !allSeenWords.has(w) && !badWords.has(w)).length === 0;
    }
    function isRiskyTrap(word) {
      const ns = lastSyllable(word);
      const opts = byFirst.get(ns) || [];
      const available = opts.filter(w => !usedWords.has(w) && !allSeenWords.has(w) && !badWords.has(w));
      if (!available.length) return false;
      return available.some(w => isDeadEndWord(w));
    }

    // ===== Nhận diện từ hiện tại (nới lỏng + nhiều cách) =====
    function findCurrentWord() {
      const candidates = [];

      // Cách 1: quét text 2 âm tiết trên màn hình (giống bản gốc, nới mobile)
      document.querySelectorAll('div, span, p, h1, h2, h3, h4, strong, b, label').forEach(el => {
        if (el.closest('#' + HELPER_ID)) return;
        const text = (el.innerText || el.textContent || '').trim();
        if (!isValidTwoSyllable(text)) return;
        if (el.offsetParent === null && getComputedStyle(el).display === 'none') return;

        const style = window.getComputedStyle(el);
        const fontSize = parseFloat(style.fontSize) || 0;
        const rect = el.getBoundingClientRect();
        if (rect.width < 10 || rect.height < 8) return;

        // Mobile: nới font + vùng nhìn
        const minFont = 12;
        const topBound = 20;
        const bottomBound = 70;
        if (fontSize < minFont) return;
        if (rect.top < topBound || rect.top > window.innerHeight - bottomBound) return;

        let score = fontSize * 2.2;
        if (style.fontWeight === 'bold' || parseInt(style.fontWeight, 10) >= 600) score += 30;
        if (style.color && /rgb\(0,\s*0,\s*0\)|#000|black/i.test(style.color)) score += 5;
        const centerY = window.innerHeight / 2;
        score += Math.max(0, 50 - Math.abs(rect.top + rect.height / 2 - centerY) / 6);
        // Ưu tiên phần tử gần giữa màn hình hơn
        if (rect.left > 20 && rect.right < window.innerWidth - 20) score += 8;

        candidates.push({ text, score, fontSize });
      });

      if (candidates.length) {
        candidates.sort((a, b) => b.score - a.score || b.fontSize - a.fontSize);
        return candidates[0].text;
      }

      // Cách 2: fallback — tìm text 2 âm tiết bất kỳ không nằm trong helper
      const allText = [];
      document.querySelectorAll('div, span, p, strong, b').forEach(el => {
        if (el.closest('#' + HELPER_ID)) return;
        const t = (el.innerText || el.textContent || '').trim();
        if (isValidTwoSyllable(t) && t.length < 40) allText.push(t);
      });
      if (allText.length) {
        // Lấy từ xuất hiện gần đây / duy nhất nhất
        return allText[allText.length - 1];
      }

      return null;
    }

    // ===== Input & chặn bàn phím =====
    function getAnswerInput() {
      return (
        document.querySelector('input.word-link-answer-input') ||
        document.querySelector('input[class*="word-link-answer"]') ||
        document.querySelector('input[class*="answer"]') ||
        document.querySelector('input[placeholder*="từ"]') ||
        document.querySelector('input[placeholder*="Từ"]') ||
        document.querySelector('input[type="text"]') ||
        document.querySelector('input:not([type])')
      );
    }

    function lockKeyboard() {
      const input = getAnswerInput();
      if (!input) return;
      try {
        input.setAttribute('readonly', 'readonly');
        input.setAttribute('inputmode', 'none');
        input.setAttribute('autocomplete', 'off');
        if (document.activeElement === input) input.blur();
      } catch (e) {}
    }

    function unlockKeyboard() {
      const input = getAnswerInput();
      if (!input) return;
      try {
        input.removeAttribute('readonly');
        input.removeAttribute('inputmode');
      } catch (e) {}
    }

    function fillWithoutFocus(el, text) {
      try {
        el.setAttribute('readonly', 'readonly');
        el.setAttribute('inputmode', 'none');

        const proto = el.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
        const setter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;
        if (setter) setter.call(el, text);
        else el.value = text;

        // Trigger nhiều event để framework React/Vue nhận
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
        el.dispatchEvent(new InputEvent('input', { bubbles: true, data: text, inputType: 'insertText' }));
        return true;
      } catch (e) {
        return false;
      }
    }

    function clickSubmit() {
      // Ưu tiên nút submit có class
      let btn =
        document.querySelector('button[class*="submitBtn"]') ||
        document.querySelector('button[class*="submit"]') ||
        document.querySelector('button[type="submit"]');

      if (!btn) {
        // Tìm nút có icon / chữ gửi
        const buttons = Array.from(document.querySelectorAll('button'));
        btn = buttons.find(b => {
          const t = (b.textContent || '').trim().toLowerCase();
          if (/gửi|send|submit|ok|xác nhận/i.test(t)) return true;
          if (b.querySelector('svg')) return true;
          return false;
        });
      }

      if (btn) {
        btn.click();
        return true;
      }

      // Fallback: Enter trên input
      const input = getAnswerInput();
      if (input) {
        input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
        input.dispatchEvent(new KeyboardEvent('keypress', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
        input.dispatchEvent(new KeyboardEvent('keyup', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
        return true;
      }
      return false;
    }

    function autoPasteAndSubmit(text) {
      const input = getAnswerInput();
      if (!input) {
        statusEl.textContent = 'Không thấy ô nhập';
        statusEl.style.color = '#dc2626';
        return;
      }

      fillWithoutFocus(input, text);

      // Không focus → không hiện bàn phím
      setTimeout(() => {
        clickSubmit();
      }, 80);

      // Thử gửi lần 2 nếu lần 1 không kịp
      setTimeout(() => {
        const stillSame = input.value && normWord(input.value) === normWord(text);
        if (stillSame) clickSubmit();
      }, 350);
    }

    function markAsBad(word) {
      if (!word) return;
      const norm = normWord(word);
      if (!norm || norm.split(' ').length !== 2) return;
      if (badWords.has(norm)) return;
      badWords.add(norm);
      saveBadWords(badWords);
      statusEl.textContent = 'Từ lỗi';
      statusEl.style.color = '#dc2626';
      setTimeout(() => {
        if (isReady) {
          statusEl.textContent = `OK (${byFirst.size})`;
          statusEl.style.color = '#10b981';
        }
      }, 1600);
    }

    function detectSubmitFailed(attemptedWord) {
      const current = findCurrentWord();
      if (current && normWord(current) === normWord(lastWord)) return true;
      const input = getAnswerInput();
      if (input && input.value && normWord(input.value) === normWord(attemptedWord)) return true;
      const errEl = Array.from(document.querySelectorAll('div, span, p')).find(el => {
        if (el.closest('#' + HELPER_ID)) return false;
        const t = (el.innerText || el.textContent || '').trim().toLowerCase();
        return t && /không tồn tại|không hợp lệ|không có trong|sai|lỗi|invalid|not found/.test(t) && t.length < 90;
      });
      return !!errEl;
    }

    function sendEscape() {
      clearTimeout(escTimer);
      const input = getAnswerInput();
      const targets = [input, document].filter(Boolean);
      targets.forEach(target => {
        target.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
        target.dispatchEvent(new KeyboardEvent('keyup', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
      });
      const skipBtn = Array.from(document.querySelectorAll('button')).find(b =>
        /bỏ qua|skip|pass|esc/i.test((b.textContent || '').trim())
      );
      if (skipBtn) skipBtn.click();
      statusEl.textContent = 'Bỏ qua';
      statusEl.style.color = '#dc2626';
      setTimeout(() => {
        if (isReady) {
          statusEl.textContent = `OK (${byFirst.size})`;
          statusEl.style.color = '#10b981';
        }
      }, 1400);
    }

    function scheduleEscape() {
      if (actionInFlight) return;
      clearTimeout(escTimer);
      actionInFlight = true;
      const delay = 400 + Math.random() * 300;
      escTimer = setTimeout(() => {
        actionInFlight = false;
        if (!autoEnabled) return;
        sendEscape();
      }, delay);
    }

    function performSubmit(full) {
      lastAttemptedWord = full;
      justSubmittedByMe = true;
      usedWords.add(full);
      actionInFlight = true;
      statusEl.textContent = 'Gửi...';
      statusEl.style.color = '#059669';
      autoPasteAndSubmit(full);

      clearTimeout(checkAcceptTimer);
      checkAcceptTimer = setTimeout(() => {
        if (lastAttemptedWord && detectSubmitFailed(lastAttemptedWord)) {
          setTimeout(() => {
            if (!lastAttemptedWord) return;
            if (detectSubmitFailed(lastAttemptedWord)) {
              markAsBad(lastAttemptedWord);
              usedWords.delete(lastAttemptedWord);
              justSubmittedByMe = false;
              actionInFlight = false;
              if (autoEnabled) {
                setTimeout(() => { if (autoEnabled) tryAutoPlay(); }, 450);
              }
            } else {
              actionInFlight = false;
            }
          }, 1200);
        } else {
          actionInFlight = false;
        }
      }, 4500);
    }

    function pickBestWord(word) {
      if (!word || !isReady) return null;
      const key = getLastSyllable(word);
      const curNorm = normWord(word);
      const allForKey = byFirst.get(key) || [];
      const available = allForKey.filter(w =>
        w !== curNorm && !usedWords.has(w) && !allSeenWords.has(w) && !badWords.has(w)
      );
      if (!available.length) return null;

      const traps = [], deads = [], risks = [], oks = [];
      available.forEach(full => {
        if (trapSet.has(full)) traps.push(full);
        else if (isDeadEndWord(full)) deads.push(full);
        else if (isRiskyTrap(full)) risks.push(full);
        else oks.push(full);
      });

      const byCont = (a, b) => contCountOf(a) - contCountOf(b);
      traps.sort(byCont);
      deads.sort(byCont);
      risks.sort(byCont);
      oks.sort(byCont);

      if (deads.length) return deads[0];
      if (traps.length) return traps[0];
      if (oks.length) return oks[0];
      if (risks.length) return risks[0];
      return null;
    }

    function tryAutoPlay() {
      if (!autoEnabled || !isReady) return;
      if (actionInFlight) return;
      clearTimeout(autoTimer);
      clearTimeout(checkAcceptTimer);
      clearTimeout(escTimer);

      if (!lastWord) {
        statusEl.textContent = 'Chưa thấy từ';
        statusEl.style.color = '#d97706';
        return;
      }

      const best = pickBestWord(lastWord);
      if (!best) {
        statusEl.textContent = 'Hết từ → ESC';
        statusEl.style.color = '#d97706';
        scheduleEscape();
        return;
      }

      const delay = 40 + Math.random() * 90;
      actionInFlight = true;
      autoTimer = setTimeout(() => {
        if (!autoEnabled) {
          actionInFlight = false;
          return;
        }
        performSubmit(best);
      }, delay);
    }

    // ===== Toggle =====
    autoBtn.addEventListener('click', e => {
      e.stopPropagation();
      autoEnabled = !autoEnabled;
      saveAuto(autoEnabled);
      updateAutoBtn();

      if (autoEnabled) {
        lockKeyboard();
        statusEl.textContent = 'Auto ON';
        statusEl.style.color = '#059669';
        if (lastWord) tryAutoPlay();
        else {
          statusEl.textContent = 'Chờ từ...';
          statusEl.style.color = '#d97706';
        }
      } else {
        unlockKeyboard();
        clearTimeout(autoTimer);
        clearTimeout(checkAcceptTimer);
        clearTimeout(escTimer);
        actionInFlight = false;
        statusEl.textContent = isReady ? `OK (${byFirst.size})` : 'Tải từ...';
        statusEl.style.color = isReady ? '#10b981' : '#d97706';
      }
    });

    // ===== Tick =====
    function tick() {
      if (autoEnabled) lockKeyboard();

      const word = findCurrentWord();
      if (word) {
        currentEl.textContent = word;
      } else {
        currentEl.textContent = autoEnabled ? 'Đang tìm từ...' : '';
      }

      if (word && word !== lastWord) {
        const norm = normWord(word);
        const isTwo = norm && norm.split(' ').length === 2;
        justSubmittedByMe = false;
        if (isTwo) allSeenWords.add(norm);
        lastWord = word;
        lastAttemptedWord = null;
        actionInFlight = false;
        clearTimeout(checkAcceptTimer);
        clearTimeout(escTimer);
        clearTimeout(autoTimer);

        if (autoEnabled) {
          statusEl.textContent = 'Có từ mới';
          statusEl.style.color = '#059669';
          tryAutoPlay();
        }
      }
    }

    // ===== Kéo thả =====
    let dragging = false, ox = 0, oy = 0;
    function startDrag(x, y) {
      const rect = panel.getBoundingClientRect();
      ox = x - rect.left;
      oy = y - rect.top;
      panel.style.left = rect.left + 'px';
      panel.style.top = rect.top + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    }
    function moveDrag(x, y) {
      const w = panel.offsetWidth, h = panel.offsetHeight;
      let left = Math.max(4, Math.min(window.innerWidth - w - 4, x - ox));
      let top = Math.max(4, Math.min(window.innerHeight - h - 4, y - oy));
      panel.style.left = left + 'px';
      panel.style.top = top + 'px';
      savePosition(panel.style.left, panel.style.top);
    }

    headerEl.addEventListener('touchstart', e => {
      if (e.target.closest('#noitu-m-auto')) return;
      dragging = true;
      startDrag(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    panel.addEventListener('touchmove', e => {
      if (!dragging) return;
      moveDrag(e.touches[0].clientX, e.touches[0].clientY);
      e.preventDefault();
    }, { passive: false });
    panel.addEventListener('touchend', () => { dragging = false; });

    headerEl.addEventListener('mousedown', e => {
      if (e.target.closest('#noitu-m-auto')) return;
      dragging = true;
      startDrag(e.clientX, e.clientY);
    });
    document.addEventListener('mousemove', e => { if (dragging) moveDrag(e.clientX, e.clientY); });
    document.addEventListener('mouseup', () => { dragging = false; });

    if (autoEnabled) lockKeyboard();
    tick();
    if (!window.__noituMobileTick) {
      window.__noituMobileTick = setInterval(tick, 700);
    }
  }

  createHelper();
  if (!window.__noituMobileWatchdog) {
    window.__noituMobileWatchdog = setInterval(() => {
      if (!document.getElementById(HELPER_ID)) createHelper();
    }, 1800);
  }
})();
