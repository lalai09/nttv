// ==UserScript==
// @name         Bảng Nhận Diện Từ + Gợi Ý - noitu.fun (Mobile Fixed)
// @namespace    http://tampermonkey.net/
// @version      5.0
// @description  Bảng hiển thị cố định góc trên điện thoại: nhận diện từ hiện tại + gợi ý từ nối từ kho từ Firebase
// @author       You
// @match        https://*.noitu.fun/*
// @match        https://noitu.fun/*
// @run-at       document-end
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const FIREBASE_DB_URL = "https://khotu-fc3e7-default-rtdb.asia-southeast1.firebasedatabase.app";
    const byFirst = new Map();
    const trapSet = new Set();
    let totalValidWords = 0;
    let dictReady = false;

    function normWord(w) {
        return (w || '').trim().toLowerCase().replace(/\s+/g, ' ');
    }

    function buildIndex(entries) {
        byFirst.clear();
        trapSet.clear();
        const validSet = new Set();
        for (const entry of entries) {
            const word = (typeof entry === 'string') ? entry : entry.w;
            const trap = (typeof entry === 'object' && entry) ? !!entry.trap : false;
            if (!word) continue;
            const norm = normWord(word);
            const parts = norm.split(' ');
            if (parts.length !== 2) continue;
            validSet.add(norm);
            if (trap) trapSet.add(norm);
            const first = parts[0];
            if (!byFirst.has(first)) byFirst.set(first, []);
            byFirst.get(first).push(norm);
        }
        totalValidWords = validSet.size;
    }

    function loadWords() {
        fetch(`${FIREBASE_DB_URL}/words.json`)
            .then(r => r.json())
            .then(data => {
                const entries = data ? Object.values(data) : [];
                buildIndex(entries);
                dictReady = true;
                updateDictStatus();
                if (lastText) renderSuggestions(lastText);
            })
            .catch(() => {
                dictReady = false;
                updateDictStatus();
            });
    }

    function updateDictStatus() {
        const statusEl = document.getElementById('wd-status');
        if (!statusEl) return;
        if (dictReady) {
            statusEl.textContent = `Sẵn sàng (${totalValidWords.toLocaleString('vi-VN')})`;
            statusEl.style.color = '#00ffcc';
        } else {
            statusEl.textContent = 'Lỗi tải kho từ';
            statusEl.style.color = '#ff5577';
        }
    }

    function isDeadEndWord(word, badWords) {
        const ns = word.split(' ')[1];
        const opts = byFirst.get(ns) || [];
        return opts.filter(w => w !== word && !badWords.has(w)).length === 0;
    }

    function loadBadWords() {
        try {
            const raw = localStorage.getItem('wd_bad_words');
            return raw ? new Set(JSON.parse(raw)) : new Set();
        } catch (e) { return new Set(); }
    }
    function saveBadWords(set) {
        try { localStorage.setItem('wd_bad_words', JSON.stringify([...set])); } catch (e) {}
    }
    const badWords = loadBadWords();

    function initUI() {
        if (document.getElementById('wd-mobile-panel')) return;

        const panel = document.createElement('div');
        panel.id = 'wd-mobile-panel';
        panel.style.cssText = `
            position: fixed !important;
            top: 5px !important;
            left: 5% !important;
            width: 90% !important;
            z-index: 9999999 !important;
            background: #111111 !important;
            border: 2px solid #00ffcc !important;
            border-radius: 10px !important;
            padding: 8px !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.8) !important;
            font-family: sans-serif !important;
            color: #ffffff !important;
            text-align: center !important;
            box-sizing: border-box !important;
        `;

        panel.innerHTML = `
            <div id="wd-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;cursor:grab;">
                <div style="font-size: 11px; color: #888; font-weight: bold;">TOOL NHẬN DIỆN NỐI TỪ</div>
                <div style="display:flex;align-items:center;gap:6px;">
                    <div id="wd-status" style="font-size: 10px; color: #d97706; font-weight: bold;">Đang tải...</div>
                    <button id="wd-toggle" style="border:none;background:#00ffcc;color:#000;border-radius:6px;width:20px;height:20px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;">−</button>
                </div>
            </div>
            <div id="wd-body">
                <div id="wd-original" style="padding: 8px; border: 1px solid #333; border-radius:8px; color: #ff0; font-size: 18px; font-weight: bold; margin-top:4px;">Chờ từ...</div>
                <div id="wd-suggest" style="display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin-top:8px;max-height:32vh;overflow-y:auto;"></div>
            </div>
        `;

        document.body.appendChild(panel);

        const header = document.getElementById('wd-header');
        const body = document.getElementById('wd-body');
        const toggleBtn = document.getElementById('wd-toggle');

        let collapsed = false;
        try { collapsed = localStorage.getItem('wd_collapsed') === '1'; } catch (e) {}
        function applyCollapsed() {
            body.style.display = collapsed ? 'none' : 'block';
            toggleBtn.textContent = collapsed ? '+' : '−';
            try { localStorage.setItem('wd_collapsed', collapsed ? '1' : '0'); } catch (e) {}
        }
        applyCollapsed();
        toggleBtn.addEventListener('click', e => {
            e.stopPropagation();
            collapsed = !collapsed;
            applyCollapsed();
        });

        // Kéo thả bảng
        let saved = null;
        try {
            const raw = localStorage.getItem('wd_panel_pos');
            saved = raw ? JSON.parse(raw) : null;
        } catch (e) {}
        if (saved && saved.left && saved.top) {
            panel.style.left = saved.left;
            panel.style.top = saved.top;
            panel.style.width = saved.width || panel.style.width;
        }

        let dragging = false, ox = 0, oy = 0;
        function start(x, y, target) {
            if (target.closest('#wd-toggle')) return false;
            const rect = panel.getBoundingClientRect();
            ox = x - rect.left;
            oy = y - rect.top;
            panel.style.left = rect.left + 'px';
            panel.style.top = rect.top + 'px';
            panel.style.width = rect.width + 'px';
            return true;
        }
        function move(x, y) {
            const w = panel.offsetWidth, h = panel.offsetHeight;
            let left = Math.max(4, Math.min(window.innerWidth - w - 4, x - ox));
            let top = Math.max(4, Math.min(window.innerHeight - h - 4, y - oy));
            panel.style.left = left + 'px';
            panel.style.top = top + 'px';
            try {
                localStorage.setItem('wd_panel_pos', JSON.stringify({ left: panel.style.left, top: panel.style.top, width: panel.style.width }));
            } catch (e) {}
        }
        header.addEventListener('mousedown', e => { dragging = start(e.clientX, e.clientY, e.target); });
        document.addEventListener('mousemove', e => { if (dragging) move(e.clientX, e.clientY); });
        document.addEventListener('mouseup', () => dragging = false);
        header.addEventListener('touchstart', e => {
            dragging = start(e.touches[0].clientX, e.touches[0].clientY, e.target);
        }, { passive: true });
        panel.addEventListener('touchmove', e => {
            if (!dragging) return;
            move(e.touches[0].clientX, e.touches[0].clientY);
            e.preventDefault();
        }, { passive: false });
        panel.addEventListener('touchend', () => dragging = false);
    }

    function chip(full, kind) {
        const second = full.split(' ')[1];
        const styles = {
            trap: { bg: 'rgba(255,215,0,.18)', border: '#f5c518', color: '#ffd700', mark: '★ ' },
            dead: { bg: 'rgba(255,92,122,.15)', border: '#ff5c7a', color: '#ff8fa3', mark: '✗ ' },
            ok:   { bg: 'rgba(0,255,204,.10)', border: '#00ffcc', color: '#e6fffb', mark: '' }
        };
        const s = styles[kind] || styles.ok;
        return `<div class="wd-sugg" data-full="${full}"
            style="padding:6px 10px;background:${s.bg};border:1.5px solid ${s.border};
                   border-radius:999px;font-size:13px;font-weight:600;color:${s.color};cursor:pointer;">
            ${s.mark}${second}
        </div>`;
    }

    function renderSuggestions(text) {
        const box = document.getElementById('wd-suggest');
        if (!box) return;

        if (!dictReady) {
            box.innerHTML = `<div style="color:#d97706;font-size:12px;">Đang tải kho từ...</div>`;
            return;
        }

        const norm = normWord(text);
        const parts = norm.split(' ');
        if (parts.length !== 2) {
            box.innerHTML = `<div style="color:#888;font-size:12px;">Từ không hợp lệ (2 âm tiết)</div>`;
            return;
        }

        const key = parts[1];
        const available = (byFirst.get(key) || []).filter(w => w !== norm && !badWords.has(w));

        if (!available.length) {
            box.innerHTML = `<div style="color:#ff5577;font-size:12px;">Hết từ nối cho "${key}"</div>`;
            return;
        }

        const traps = [], deads = [], oks = [];
        available.forEach(w => {
            if (trapSet.has(w)) traps.push(w);
            else if (isDeadEndWord(w, badWords)) deads.push(w);
            else oks.push(w);
        });

        const lim = 14;
        box.innerHTML =
            traps.slice(0, lim).map(w => chip(w, 'trap')).join('') +
            deads.slice(0, lim).map(w => chip(w, 'dead')).join('') +
            oks.slice(0, lim).map(w => chip(w, 'ok')).join('');

        box.querySelectorAll('.wd-sugg').forEach(el => {
            el.onclick = () => {
                const full = el.dataset.full;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(full).catch(() => {});
                }
                const input = document.querySelector('input.word-link-answer-input, input[class*="word-link-answer"], input[type="text"]');
                if (input) {
                    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
                    if (setter) setter.call(input, full);
                    else input.value = full;
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.focus();
                }
                el.style.background = '#059669';
            };
        });
    }

    let lastText = "";

    function scanWord() {
        initUI();

        const allTextElements = document.querySelectorAll('*');
        let matchedText = "";

        for (let el of allTextElements) {
            if (el.closest('#wd-mobile-panel')) continue;
            if (el.children.length === 0 && el.innerText) {
                const text = el.innerText.trim();

                if (
                    text.length >= 2 &&
                    !text.includes('\n') &&
                    !['ĐIỂM', 'Đối thủ', 'Bỏ qua', 'ĐÃ NỐI', 'esc', 'Bot', 'Chơi', 'nhóm'].some(k => text.includes(k)) &&
                    !/^\d+$/.test(text)
                ) {
                    const style = window.getComputedStyle(el);
                    if (parseFloat(style.fontSize) >= 20 && el.getBoundingClientRect().height > 0) {
                        matchedText = text;
                    }
                }
            }
        }

        if (matchedText && matchedText !== lastText) {
            lastText = matchedText;
            const words = matchedText.split(/\s+/);
            const lastSyllable = words[words.length - 1];

            const origEl = document.getElementById('wd-original');
            const targetEl = document.getElementById('wd-target');

            if (origEl && targetEl) {
                origEl.innerText = matchedText;
                targetEl.innerText = lastSyllable;
            }

            renderSuggestions(matchedText);
        }
    }

    setTimeout(initUI, 1000);
    loadWords();
    setInterval(loadWords, 15000);
    setInterval(scanWord, 200);
})();
